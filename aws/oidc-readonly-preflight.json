{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "AuraKinetix: restricted GitHub Actions OIDC STS identity role, referencing an EXISTING account OIDC provider; no workload resources.",
  "Parameters": {
    "GitHubOwner": {
      "Type": "String",
      "Default": "sahil03kundu-code",
      "AllowedPattern": "^[A-Za-z0-9_.-]+$"
    },
    "GitHubRepository": {
      "Type": "String",
      "Default": "AuraKinetix",
      "AllowedPattern": "^[A-Za-z0-9_.-]+$"
    }
  },
  "Resources": {
    "GitHubReadOnlyPreflightRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "GitHub Actions main-branch OIDC identity verification; no AWS API permissions beyond STS identity introspection",
        "MaxSessionDuration": 3600,
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Federated": {
                  "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:oidc-provider/token.actions.githubusercontent.com"
                }
              },
              "Action": "sts:AssumeRoleWithWebIdentity",
              "Condition": {
                "StringEquals": {
                  "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
                  "token.actions.githubusercontent.com:sub": {
                    "Fn::Sub": "repo:${GitHubOwner}/${GitHubRepository}:ref:refs/heads/main"
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "After the existing GitHub OIDC provider and role are manually verified, set GitHub repository variable AWS_READONLY_ROLE_ARN to this role ARN",
      "Value": {
        "Fn::GetAtt": [
          "GitHubReadOnlyPreflightRole",
          "Arn"
        ]
      }
    }
  }
}
